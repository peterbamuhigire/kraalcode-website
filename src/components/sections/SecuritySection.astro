---
interface Props {
  locale: 'en' | 'fr' | 'sw';
}

const { locale } = Astro.props;

const content: Record<string, {
  heading: string;
  subtext: string;
  cta: string;
  ctaHref: string;
  controls: Array<{ icon: string; title: string; description: string }>;
}> = {
  en: {
    heading: 'Security that enables your operations',
    subtext: 'Security and privacy are not afterthoughts — they are what makes remote work, branch operations, and cloud access possible without abandoning accountability.',
    cta: 'Visit the Trust Centre',
    ctaHref: '/en/security/',
    controls: [
      { icon: '⬡', title: 'Tenant isolation', description: 'Every organisation\'s data is isolated at the database level. Cross-tenant access is prevented by design.' },
      { icon: '⬢', title: 'Role-based access control', description: 'Unlimited roles with granular permissions, branch restrictions, and approval limits control who can see and do what.' },
      { icon: '◈', title: 'Immutable audit trail', description: 'Every action is recorded in an INSERT-only log with 7-year retention. No one can alter or delete the record.' },
      { icon: '◇', title: 'AES-256 encryption', description: 'Sensitive data — salary, bank accounts, national IDs — is encrypted at rest. All traffic uses TLS 1.3.' },
      { icon: '⬡', title: 'Multi-factor authentication', description: 'TOTP-based two-factor authentication and biometric login protect account access.' },
      { icon: '⬢', title: 'OWASP Top 10 mapped', description: 'Security architecture is designed against all ten OWASP Top 10 (2021) categories with specific controls.' },
    ],
  },
  fr: {
    heading: 'La sécurité qui enable vos opérations',
    subtext: 'La sécurité et la confidentialité sont ce qui rend le travail à distance et l\'accès cloud possibles sans abandonner la responsabilité.',
    cta: 'Visiter le Centre de Confiance',
    ctaHref: '/fr/securite/',
    controls: [
      { icon: '⬡', title: 'Isolation des locataires', description: 'Les données de chaque organisation sont isolées au niveau de la base de données.' },
      { icon: '⬢', title: 'Contrôle d\'accès basé sur les rôles', description: 'Rôles illimités avec permissions granulaires et limites d\'approbation.' },
      { icon: '◈', title: 'Piste d\'audit immutable', description: 'Chaque action est enregistrée dans un journal INSERT-only avec rétention de 7 ans.' },
      { icon: '◇', title: 'Chiffrement AES-256', description: 'Les données sensibles sont chiffrées au repos. Tout le trafic utilise TLS 1.3.' },
      { icon: '⬡', title: 'Authentification multi-facteurs', description: 'Authentification à deux facteurs TOTP et connexion biométrique.' },
      { icon: '⬢', title: 'OWASP Top 10 cartographié', description: 'L\'architecture de sécurité couvre les dix catégories OWASP Top 10 (2021).' },
    ],
  },
  sw: {
    heading: 'Usalama unaowezesha shughuli zako',
    subtext: 'Usalama na faragha si mawazo ya baadaye — ni kile kinachofanya kazi ya mbali na ufikiaji wa wingu kuwezekana.',
    cta: 'Tembelea Kituo cha Uaminifu',
    ctaHref: '/sw/usalama/',
    controls: [
      { icon: '⬡', title: 'Utoaji wa mpangilio', description: 'Data ya kila shirika imetenganishwa katika ngazi ya hifadhidata.' },
      { icon: '⬢', title: 'Udhibiti wa ufikiaji kulingana na majukumu', description: 'Majukumu yasiyo na kikomo na ruhusa za kina.' },
      { icon: '◈', title: 'Njia ya ukaguzi isiyobadilika', description: 'Kila kitendo kinasajiliwa katika logi ya INSERT-only na uhifadhi wa miaka 7.' },
      { icon: '◇', title: 'Ufichaji wa AES-256', description: 'Data nyeti imeshifwa. Trafiki yote inatumia TLS 1.3.' },
      { icon: '⬡', title: 'Uthibitishaji wa sababu nyingi', description: 'Uthibitishaji wa sababu mbili za TOTP na kuingia kwa biometriki.' },
      { icon: '⬢', title: 'OWASP Top 10 imechorwa', description: 'Usanifu wa usalama unashughulikia jamii zote kumi za OWASP Top 10 (2021).' },
    ],
  },
};

const t = content[locale];
---

<section class="security-section section--dark" aria-labelledby="security-heading">
  <div class="container">
    <div class="security-header">
      <h2 id="security-heading">{t.heading}</h2>
      <p>{t.subtext}</p>
    </div>
    <div class="security-grid">
      {t.controls.map((ctrl) => (
        <div class="security-card">
          <span class="security-icon" aria-hidden="true">{ctrl.icon}</span>
          <h3>{ctrl.title}</h3>
          <p>{ctrl.description}</p>
        </div>
      ))}
    </div>
    <div class="security-cta">
      <a href={t.ctaHref} class="btn btn--inverse">{t.cta} →</a>
    </div>
  </div>
</section>

<style>
  .security-header {
    max-width: 640px;
    margin-bottom: var(--kc-space-12);
  }

  .security-header h2 {
    font-size: var(--kc-text-3xl);
  }

  .security-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--kc-space-6);
    margin-bottom: var(--kc-space-10);
  }

  .security-card {
    padding: var(--kc-space-6);
    border: 1px solid var(--kc-border-dark);
    border-radius: var(--kc-radius-lg);
    background: rgba(255, 255, 255, 0.03);
  }

  .security-icon {
    font-size: var(--kc-text-2xl);
    color: var(--kc-teal-light);
    display: block;
    margin-bottom: var(--kc-space-3);
  }

  .security-card h3 {
    font-family: var(--kc-font-body);
    font-size: var(--kc-text-base);
    font-weight: var(--kc-weight-semibold);
    color: var(--kc-text-inverse);
    margin-bottom: var(--kc-space-2);
  }

  .security-card p {
    font-size: var(--kc-text-sm);
    color: var(--kc-text-inverse-muted);
    margin: 0;
  }

  .security-cta {
    text-align: center;
  }

  .btn--inverse {
    display: inline-flex;
    align-items: center;
    padding: var(--kc-space-3) var(--kc-space-6);
    font-weight: var(--kc-weight-semibold);
    font-size: var(--kc-text-sm);
    border-radius: var(--kc-radius-lg);
    background: transparent;
    color: var(--kc-text-inverse);
    border: 2px solid var(--kc-teal-light);
    transition: all var(--kc-transition-fast);
    text-decoration: none;
  }

  .btn--inverse:hover {
    background: var(--kc-teal);
    border-color: var(--kc-teal);
  }

  @media (max-width: 1024px) {
    .security-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .security-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
