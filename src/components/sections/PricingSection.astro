---
interface Props {
  locale: 'en' | 'fr' | 'sw';
}

const { locale } = Astro.props;

const content: Record<string, {
  heading: string;
  subtext: string;
  cta: string;
  ctaHref: string;
  tiers: Array<{ name: string; price: string; users: string; branches: string }>;
  note: string;
}> = {
  en: {
    heading: 'One price for your whole organisation',
    subtext: 'No per-seat fees. No hidden implementation costs. No USD exchange rate surprises. Pay for the plan that fits your size — every employee gets access.',
    cta: 'See full pricing',
    ctaHref: '/en/pricing/',
    tiers: [
      { name: 'Starter', price: 'UGX 250,000', users: 'Up to 5 users', branches: 'Up to 2 branches' },
      { name: 'Professional', price: 'UGX 1,000,000', users: 'Up to 30 users', branches: 'Up to 10 branches' },
      { name: 'Enterprise', price: 'UGX 2,500,000', users: 'Unlimited users', branches: 'Unlimited branches' },
    ],
    note: 'All prices per month. Annual billing: 10 months for 12 months access.',
  },
  fr: {
    heading: 'Un prix pour toute votre organisation',
    subtext: 'Pas de frais par utilisateur. Pas de coûts d\'implémentation cachés. Payez pour le plan qui convient à votre taille.',
    cta: 'Voir les tarifs complets',
    ctaHref: '/fr/tarifs/',
    tiers: [
      { name: 'Starter', price: '250 000 UGX', users: 'Jusqu\'à 5 utilisateurs', branches: 'Jusqu\'à 2 succursales' },
      { name: 'Professionnel', price: '1 000 000 UGX', users: 'Jusqu\'à 30 utilisateurs', branches: 'Jusqu\'à 10 succursales' },
      { name: 'Entreprise', price: '2 500 000 UGX', users: 'Utilisateurs illimités', branches: 'Succursales illimitées' },
    ],
    note: 'Tous les prix par mois. Facturation annuelle : 10 mois pour 12 mois d\'accès.',
  },
  sw: {
    heading: 'Bei moja kwa shirika lako lote',
    subtext: 'Hakuna ada kwa kila mtumiaji. Hakuna gharama za utekelezaji zilizofichwa. Lipa kwa mpango unaofaa ukubwa wako.',
    cta: 'Ona bei kamili',
    ctaHref: '/sw/bei/',
    tiers: [
      { name: 'Starter', price: 'UGX 250,000', users: 'Hadi watumiaji 5', branches: 'Hadi matawi 2' },
      { name: 'Professional', price: 'UGX 1,000,000', users: 'Hadi watumiaji 30', branches: 'Hadi matawi 10' },
      { name: 'Enterprise', price: 'UGX 2,500,000', users: 'Watumiaji wasio na kikomo', branches: 'Matawi yasiyo na kikomo' },
    ],
    note: 'Bei zote kwa mwezi. Bili ya mwaka: miezi 10 kwa miezi 12 ya ufikiaji.',
  },
};

const t = content[locale];
---

<section class="pricing-section section section--warm" aria-labelledby="pricing-heading">
  <div class="container">
    <div class="pricing-header text-center">
      <h2 id="pricing-heading">{t.heading}</h2>
      <p>{t.subtext}</p>
    </div>
    <div class="pricing-grid grid grid--3">
      {t.tiers.map((tier, i) => (
        <div class:list={['pricing-card', { 'pricing-card--featured': i === 1 }]}>
          {i === 1 && <span class="pricing-badge">Most popular</span>}
          <h3>{tier.name}</h3>
          <div class="pricing-amount">{tier.price}</div>
          <p class="pricing-period">/month</p>
          <ul class="pricing-features" role="list">
            <li>{tier.users}</li>
            <li>{tier.branches}</li>
            <li>6 core modules included</li>
            <li>Add-on modules available</li>
          </ul>
        </div>
      ))}
    </div>
    <p class="pricing-note">{t.note}</p>
    <div class="pricing-cta text-center">
      <a href={t.ctaHref} class="btn btn--primary">{t.cta} →</a>
    </div>
  </div>
</section>

<style>
  .pricing-header {
    max-width: 560px;
    margin: 0 auto var(--kc-space-12);
  }

  .pricing-header h2 {
    font-size: var(--kc-text-3xl);
    color: var(--kc-charcoal);
  }

  .pricing-card {
    padding: var(--kc-space-8);
    background: var(--kc-surface-light);
    border: 1px solid var(--kc-border-subtle);
    border-radius: var(--kc-radius-lg);
    text-align: center;
    position: relative;
  }

  .pricing-card--featured {
    border-color: var(--kc-teal);
    box-shadow: var(--kc-shadow-lg);
  }

  .pricing-badge {
    position: absolute;
    top: calc(-1 * var(--kc-space-3));
    left: 50%;
    transform: translateX(-50%);
    background: var(--kc-teal);
    color: var(--kc-text-inverse);
    font-size: var(--kc-text-xs);
    font-weight: var(--kc-weight-semibold);
    padding: var(--kc-space-1) var(--kc-space-3);
    border-radius: var(--kc-radius-full);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .pricing-card h3 {
    font-family: var(--kc-font-body);
    font-size: var(--kc-text-xl);
    font-weight: var(--kc-weight-semibold);
    color: var(--kc-charcoal);
    margin-bottom: var(--kc-space-3);
  }

  .pricing-amount {
    font-family: var(--kc-font-display);
    font-size: var(--kc-text-3xl);
    font-weight: var(--kc-weight-bold);
    color: var(--kc-teal);
  }

  .pricing-period {
    font-size: var(--kc-text-sm);
    color: var(--kc-text-tertiary);
    margin-bottom: var(--kc-space-6);
  }

  .pricing-features {
    display: flex;
    flex-direction: column;
    gap: var(--kc-space-3);
    text-align: left;
  }

  .pricing-features li {
    font-size: var(--kc-text-sm);
    color: var(--kc-text-secondary);
    padding-left: var(--kc-space-5);
    position: relative;
  }

  .pricing-features li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--kc-teal);
    font-weight: var(--kc-weight-bold);
  }

  .pricing-note {
    text-align: center;
    font-size: var(--kc-text-sm);
    color: var(--kc-text-tertiary);
    margin-top: var(--kc-space-6);
    margin-bottom: var(--kc-space-6);
  }

  .pricing-cta {
    padding: var(--kc-space-2) var(--kc-space-4) var(--kc-space-4);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    padding: var(--kc-space-3) var(--kc-space-6);
    font-weight: var(--kc-weight-semibold);
    font-size: var(--kc-text-sm);
    border-radius: var(--kc-radius-lg);
    background: var(--kc-charcoal);
    color: var(--kc-text-inverse);
    transition: all var(--kc-transition-fast);
    text-decoration: none;
  }

  .btn:hover {
    background: var(--kc-teal-deep);
    color: var(--kc-text-inverse);
  }
</style>
