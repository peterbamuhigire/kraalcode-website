const t = copy[locale];
const required = '*';
---

<form
  class="contact-form"
  data-contact-form
  data-invalid-message={t.invalidMessage}
  data-unavailable-message={t.unavailableMessage}
  data-loading-label={t.loadingLabel}
  method="POST"
  action="#"
  novalidate
  aria-labelledby="contact-form-heading"
>
  <h2 id="contact-form-heading">{t.formTitle}</h2>

  <p id="form-status" class="form-status" role="alert" aria-live="assertive" aria-atomic="true" tabindex="-1" hidden></p>

  <div class="hp-field" aria-hidden="true">
    <label for="website">{t.labels.website}</label>
    <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
  </div>

  <div class="form-group">
    <label for="name">{t.labels.name} <span class="required" aria-hidden="true">{required}</span></label>
    <input type="text" id="name" name="name" required autocomplete="name" aria-invalid="false" aria-describedby="name-error" />
    <p id="name-error" class="field-error" hidden>{t.errors.name}</p>
  </div>

  <div class="form-group">
    <label for="email">{t.labels.email} <span class="required" aria-hidden="true">{required}</span></label>
    <input type="email" id="email" name="email" required autocomplete="email" aria-invalid="false" aria-describedby="email-error" />
    <p id="email-error" class="field-error" hidden>{t.errors.email}</p>
  </div>

  <div class="form-group">
    <label for="organisation">{t.labels.organisation} <span class="required" aria-hidden="true">{required}</span></label>
    <input type="text" id="organisation" name="organisation" required autocomplete="organization" aria-invalid="false" aria-describedby="organisation-error" />
    <p id="organisation-error" class="field-error" hidden>{t.errors.organisation}</p>
  </div>

  <div class="form-group">
    <label for="country">{t.labels.country} <span class="required" aria-hidden="true">{required}</span></label>
    <select id="country" name="country" required aria-invalid="false" aria-describedby="country-error">
      <option value="">{t.placeholders.country}</option>
      {t.countries.map((option) => <option value={option.value}>{option.label}</option>)}
    </select>
    <p id="country-error" class="field-error" hidden>{t.errors.country}</p>
  </div>

  <div class="form-group">
    <label for="role">{t.labels.role}</label>
    <select id="role" name="role">
      <option value="">{t.placeholders.role}</option>
      {t.roles.map((option) => <option value={option.value}>{option.label}</option>)}
    </select>
  </div>

  <div class="form-group">
    <label for="size">{t.labels.size}</label>
    <select id="size" name="size">
      <option value="">{t.placeholders.size}</option>
      {t.sizes.map((option) => <option value={option.value}>{option.label}</option>)}
    </select>
  </div>

  <div class="form-group">
    <label for="interests">{t.labels.interests}</label>
    <textarea id="interests" name="interests" rows="3" placeholder={t.placeholders.interests}></textarea>
  </div>

  <div class="form-group">
    <label for="message">{t.labels.message}</label>
    <textarea id="message" name="message" rows="3" placeholder={t.placeholders.message}></textarea>
  </div>

  <div class="form-group form-checkbox">
    <input type="checkbox" id="privacy" name="privacy" required aria-invalid="false" aria-describedby="privacy-error" />
    <div>
      <label for="privacy">{t.labels.privacy} <span class="required" aria-hidden="true">{required}</span></label>
      <p id="privacy-error" class="field-error" hidden>{t.errors.privacy}</p>
    </div>
  </div>

  <div class="form-group form-checkbox">
    <input type="checkbox" id="marketing" name="marketing" />
    <label for="marketing">{t.labels.marketing}</label>
  </div>

  <button type="submit" class="btn btn--primary btn--full" data-default-label={t.submitLabel}>{t.submitLabel}</button>
  <p class="form-note">
    {locale === 'fr' ? <>En envoyant ce formulaire, vous acceptez que Chwezi Core Systems Limited traite vos coordonnées pour vous répondre, conformément à notre <a href="https://chwezicore.com/fr/data-protection-policy/" target="_blank" rel="noopener noreferrer">Politique de protection des données et de la vie privée</a>. Nos serveurs sont situés aux États-Unis d’Amérique, en Finlande et en Allemagne.</> : <>By submitting this form, you agree that Chwezi Core Systems Limited will process your details to respond to you, as described in our <a href="https://chwezicore.com/en/data-protection-policy/" target="_blank" rel="noopener noreferrer">Data Protection and Privacy Policy</a>. Our servers are located in the United States of America, Finland and Germany.</>}
  </p>
  <p id="form-note" class="form-note">{t.formNote}</p>
</form>

<style>
  .contact-form {
    padding: var(--kc-space-8);
    background: var(--kc-surface-light);
    border: 1px solid var(--kc-border-subtle);
    border-radius: var(--kc-radius-lg);
  }

  .contact-form h2 {
    font-size: var(--kc-text-xl);
    font-family: var(--kc-font-body);
    font-weight: var(--kc-weight-semibold);
    margin-bottom: var(--kc-space-6);
  }

  .form-status {
    padding: var(--kc-space-4);
    margin-bottom: var(--kc-space-5);
    border: 1px solid var(--kc-danger);
    border-radius: var(--kc-radius-md);
    background: var(--kc-danger-light);
    color: var(--kc-danger);
    font-size: var(--kc-text-sm);
  }

  .form-group {
    margin-bottom: var(--kc-space-5);
    scroll-margin-block: 7rem;
  }

  .form-group label {
    display: block;
    margin-bottom: var(--kc-space-2);
    color: var(--kc-text-primary);
    font-size: var(--kc-text-sm);
    font-weight: var(--kc-weight-medium);
  }

  .required {
    color: var(--kc-danger);
  }

  .form-group input[type='text'],
  .form-group input[type='email'],
  .form-group select,
  .form-group textarea {
    width: 100%;
    padding: var(--kc-space-3) var(--kc-space-4);
    border: 1px solid var(--kc-border);
    border-radius: var(--kc-radius-md);
    background: var(--kc-surface-light);
    color: var(--kc-text-primary);
    font-size: var(--kc-text-base);
    font-family: var(--kc-font-body);
    transition: border-color var(--kc-transition-fast), box-shadow var(--kc-transition-fast);
  }

  .form-group input:focus,
  .form-group select:focus,
  .form-group textarea:focus {
    border-color: var(--kc-teal);
    box-shadow: 0 0 0 3px rgba(70, 105, 107, 0.14);
  }

  .form-group input:focus-visible,
  .form-group select:focus-visible,
  .form-group textarea:focus-visible {
    outline: 3px solid var(--kc-focus-ring);
    outline-offset: 2px;
  }

  .form-group textarea {
    min-height: 5rem;
    resize: vertical;
  }

  .form-checkbox {
    display: flex;
    align-items: flex-start;
    gap: var(--kc-space-3);
  }

  .form-checkbox input[type='checkbox'] {
    width: 24px;
    height: 24px;
    flex: 0 0 24px;
    margin-top: 1px;
  }

  .form-checkbox > div {
    flex: 1;
  }

  .form-checkbox label {
    margin-bottom: 0;
    color: var(--kc-text-secondary);
  }

  .form-group.error input,
  .form-group.error select,
  .form-group.error textarea {
    border-color: var(--kc-danger);
  }

  .form-group.error input:focus-visible,
  .form-group.error select:focus-visible,
  .form-group.error textarea:focus-visible {
    outline-color: var(--kc-danger);
  }

  .field-error {
    margin-top: var(--kc-space-1);
    color: var(--kc-danger);
    font-size: var(--kc-text-xs);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3rem;
    padding: var(--kc-space-4) var(--kc-space-8);
    border: none;
    border-radius: var(--kc-radius-lg);
    background: var(--kc-charcoal);
    color: var(--kc-text-inverse);
    font-size: var(--kc-text-base);
    font-weight: var(--kc-weight-semibold);
    text-decoration: none;
    cursor: pointer;
    transition: background-color var(--kc-transition-fast), opacity var(--kc-transition-fast);
  }

  .btn:hover {
    background: var(--kc-teal-deep);
    color: var(--kc-text-inverse);
  }

  .btn:disabled {
    cursor: wait;
    opacity: 0.7;
  }

  .btn--full {
    width: 100%;
  }

  .btn--loading::after {
    width: 1rem;
    height: 1rem;
    margin-left: var(--kc-space-2);
    border: 2px solid currentColor;
    border-right-color: transparent;
    border-radius: 50%;
    content: '';
    animation: contact-form-spin 0.6s linear infinite;
  }

  .form-note {
    margin-top: var(--kc-space-4);
    color: var(--kc-text-tertiary);
    font-size: var(--kc-text-xs);
    text-align: center;
  }

  .hp-field {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  [hidden] {
    display: none !important;
  }

  @keyframes contact-form-spin {
    to { transform: rotate(360deg); }
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');

  if (form) {
    const submitButton = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const status = form.querySelector<HTMLElement>('#form-status');
    const requiredFields = Array.from(
      form.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>('[required]'),
    );
    const defaultLabel = submitButton?.dataset.defaultLabel ?? submitButton?.textContent ?? '';

    const hasValue = (field: HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement): boolean => {
      if (field instanceof HTMLInputElement && field.type === 'checkbox') return field.checked;
      return field.value.trim().length > 0;
    };

    const isValid = (field: HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement): boolean => {
      const formatIsValid = !(field instanceof HTMLInputElement && field.type === 'email') || field.validity.valid;
      return hasValue(field) && formatIsValid;
    };

    const setFieldError = (field: HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement, invalid: boolean): void => {
      const group = field.closest('.form-group');
      const message = document.getElementById(`${field.id}-error`);
      group?.classList.toggle('error', invalid);
      field.setAttribute('aria-invalid', String(invalid));
      if (message) message.hidden = !invalid;
    };

    const clearStatus = (): void => {
      if (!status) return;
      status.hidden = true;
      status.textContent = '';
    };

    const showStatus = (message: string): void => {
      if (!status) return;
      status.textContent = message;
      status.hidden = false;
    };

    requiredFields.forEach((field) => {
      const eventName = field instanceof HTMLSelectElement || (field instanceof HTMLInputElement && field.type === 'checkbox')
        ? 'change'
        : 'input';

      field.addEventListener(eventName, () => {
        clearStatus();
        if (isValid(field)) setFieldError(field, false);
      });
    });

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      clearStatus();

      const honeypot = form.querySelector<HTMLInputElement>('#website');
      if (honeypot?.value) return;

      let valid = true;
      let firstInvalid: HTMLElement | undefined;

      requiredFields.forEach((field) => {
        const fieldIsValid = isValid(field);
        setFieldError(field, !fieldIsValid);
        if (!fieldIsValid) {
          valid = false;
          firstInvalid ??= field;
        }
      });

      if (!valid) {
        showStatus(form.dataset.invalidMessage ?? 'Please correct the highlighted fields.');
        firstInvalid?.focus();
        return;
      }

      if (!submitButton) return;
      submitButton.disabled = true;
      submitButton.setAttribute('aria-busy', 'true');
      submitButton.classList.add('btn--loading');
      submitButton.textContent = form.dataset.loadingLabel ?? 'Checking request…';

      window.setTimeout(() => {
        submitButton.disabled = false;
        submitButton.removeAttribute('aria-busy');
        submitButton.classList.remove('btn--loading');
        submitButton.textContent = defaultLabel;
        showStatus(form.dataset.unavailableMessage ?? 'This form is not connected to a submission service yet.');
        status?.focus();
      }, 300);
    });
  }
</script>
