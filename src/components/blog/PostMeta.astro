---
interface Props {
  date: Date;
  author: string;
  readingTime: number;
  category: string;
  locale?: 'en' | 'fr' | 'sw';
}

const { date, author, readingTime, category, locale = 'en' } = Astro.props;
const categoryLabels: Record<string, Record<'en' | 'fr' | 'sw', string>> = {
  'product-updates': { en: 'Product updates', fr: 'Actualités produit', sw: 'Habari za bidhaa' },
  'industry-insights': { en: 'Industry insights', fr: 'Regards sur le secteur', sw: 'Maarifa ya sekta' },
  'how-to-guides': { en: 'How-to guides', fr: 'Guides pratiques', sw: 'Mwongozo wa vitendo' },
  'security-compliance': { en: 'Security & compliance', fr: 'Sécurité et conformité', sw: 'Usalama na uzingatiaji' },
  'customer-stories': { en: 'Customer stories', fr: 'Témoignages clients', sw: 'Hadithi za wateja' },
};
const formattedDate = new Intl.DateTimeFormat(locale === 'fr' ? 'fr-FR' : locale === 'sw' ? 'sw-KE' : 'en-GB', {
  day: 'numeric', month: 'long', year: 'numeric',
}).format(date);
const readingLabel = locale === 'fr' ? `${readingTime} min de lecture` : locale === 'sw' ? `Dakika ${readingTime}` : `${readingTime} min read`;
---

<div class="post-meta">
  <span>{categoryLabels[category]?.[locale] ?? category}</span>
  <span aria-hidden="true">·</span>
  <time datetime={date.toISOString()}>{formattedDate}</time>
  <span aria-hidden="true">·</span>
  <span>{readingLabel}</span>
  <span class="sr-only"> by {author}</span>
</div>

<style>
  .post-meta { display: flex; flex-wrap: wrap; gap: var(--kc-space-2); align-items: center; color: var(--kc-text-tertiary); font-size: var(--kc-text-sm); }
  .post-meta span:first-child { color: var(--kc-teal-deep); font-weight: var(--kc-weight-semibold); }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
</style>
