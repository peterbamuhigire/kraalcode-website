---
import PostCard from './PostCard.astro';
import { blogSlug } from '../../utils/blog';

interface Props {
  posts: Array<any>;
  locale?: 'en' | 'fr' | 'sw';
  basePath?: string;
}

const { posts, locale = 'en', basePath = '/en/blog' } = Astro.props;
const heading = locale === 'fr' ? 'À lire aussi' : locale === 'sw' ? 'Endelea kusoma' : 'Keep reading';
const relatedPosts = posts.slice(0, 3).map((post) => ({
  slug: post.slug ?? blogSlug(post),
  data: post.data,
}));
---

{posts.length > 0 && (
  <section class="related-posts" aria-labelledby="related-heading">
    <h2 id="related-heading">{heading}</h2>
    <div class="related-posts__grid">
      {relatedPosts.map((post) => <PostCard post={post} locale={locale} basePath={basePath} />)}
    </div>
  </section>
)}

<style>
  .related-posts { margin-top: var(--kc-space-16); padding-top: var(--kc-space-12); border-top: 1px solid var(--kc-border-subtle); }
  .related-posts h2 { margin-bottom: var(--kc-space-6); }
  .related-posts__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--kc-space-6); }
  @media (max-width: 900px) { .related-posts__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 600px) { .related-posts__grid { grid-template-columns: 1fr; } }
</style>
