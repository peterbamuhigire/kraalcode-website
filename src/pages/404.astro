---
import BaseLayout from '../layouts/BaseLayout.astro';
const locale = 'en';
---

<BaseLayout
  title="Page Not Found"
  description="The page you are looking for does not exist or has been moved."
  locale={locale}
  canonicalUrl="https://kraalcode.com/404/"
  noindex={true}
>
  <section class="error-page">
    <div class="container">
      <div class="error-content">
        <span class="error-code">404</span>
        <h1>Page not found</h1>
        <p>The page you are looking for does not exist or has been moved.</p>
        <div class="error-actions">
          <a href="/en/" class="btn btn--primary">Go to homepage</a>
          <a href="/en/capabilities/" class="btn btn--outline">Explore capabilities</a>
          <a href="/en/contact/" class="btn btn--outline">Contact us</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .error-page {
    min-height: 60vh;
    display: flex;
    align-items: center;
    padding: var(--kc-space-20) 0;
  }

  .error-content {
    max-width: 500px;
    text-align: center;
    margin: 0 auto;
  }

  .error-code {
    font-family: var(--kc-font-display);
    font-size: 8rem;
    font-weight: var(--kc-weight-bold);
    color: var(--kc-teal);
    opacity: 0.2;
    line-height: 1;
    display: block;
    margin-bottom: var(--kc-space-4);
  }

  .error-content h1 {
    font-size: var(--kc-text-3xl);
    margin-bottom: var(--kc-space-4);
  }

  .error-content p {
    font-size: var(--kc-text-lg);
    color: var(--kc-text-secondary);
    margin-bottom: var(--kc-space-8);
  }

  .error-actions {
    display: flex;
    gap: var(--kc-space-4);
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    padding: var(--kc-space-3) var(--kc-space-6);
    font-weight: var(--kc-weight-semibold);
    font-size: var(--kc-text-sm);
    border-radius: var(--kc-radius-lg);
    text-decoration: none;
    transition: all var(--kc-transition-fast);
  }

  .btn--primary {
    background: var(--kc-charcoal);
    color: var(--kc-text-inverse);
  }

  .btn--primary:hover {
    background: var(--kc-teal-deep);
  }

  .btn--outline {
    background: transparent;
    color: var(--kc-text-primary);
    border: 1px solid var(--kc-border);
  }

  .btn--outline:hover {
    border-color: var(--kc-teal);
    color: var(--kc-teal);
  }

  @media (max-width: 640px) {
    .error-code { font-size: 5rem; }
    .error-content h1 { font-size: var(--kc-text-2xl); }
    .error-actions { flex-direction: column; }
  }
</style>
