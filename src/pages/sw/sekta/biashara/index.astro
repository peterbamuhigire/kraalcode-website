---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
const locale = 'sw';
---

<BaseLayout
  title="Biashara na Usambazaji — ERP kwa Wauzaji Wadogo, Wasambazaji na Waagizaji"
  description="Kraal Code kwa biashara: hifadhi za ghala nyingi, ufuatiliaji wa mizigo, utoaji FEFO, wawakala wa mauzo na usimamizi wa utoaji."
  locale={locale}
  canonicalUrl="https://kraalcode.com/sw/sekta/biashara/"
>
  <section class="page-hero section--warm"><div class="container">
    <nav class="breadcrumb" aria-label="Njia ya mkate"><ol><li><a href="/sw/">Nyumbani</a></li><li><a href="/sw/sekta/">Sekta</a></li><li aria-current="page">Biashara na Usambazaji</li></ol></nav>
    <h1>Biashara na Usambazaji</h1>
    <p class="page-hero-subtext">Hamisha bidhaa kati ya maeneo na mwonekano kamili. Hifadhi za ghala nyingi, ufuatiliaji wa mizigo, wawakala wa mauzo na usimamizi wa utoaji — kitabu kimoja.</p>
  </div></section>

  <section class="section"><div class="container container--narrow">
    <h2>Changamoto zako</h2>
    <div class="challenge-grid">
      <div class="challenge-item"><h3>Hifadhi za maeneo mengi</h3><p>Una ghala, maduka na wawakala katika maeneo mengi. Kujua kilicho wapi kunahitaji simu na karatasi za hesabu.</p></div>
      <div class="challenge-item"><h3>Usimamizi wa muda wa matumizi</h3><p>Bidhaa zinaisha muda. Bila ufuatiliaji wa mizigo na utoaji FEFO, vitu vinaisha dukani wakati hisa mpya zinauzwa kwanza.</p></div>
      <div class="challenge-item"><h3>Nguvu za uwanja</h3><p>Mawakala wa mauzo wanafanya kazi uwanjani na hisa zao wenyewe. Hujui mauzo yao ya kila siku, viwango vya hisa au majukumu ya kamisheni.</p></div>
    </div>
  </div></section>

  <section class="section section--warm"><div class="container">
    <h2>Jinsi Kraal Code inavyosaidia</h2>
    <div class="feature-grid">
      <div class="feature-card"><h3>Hifadhi za Ghala Nyingi</h3><p>Simamia hisa katika ghala, maduka, viwandani na maeneo ya wawakala. Mtazamo kwa eneo au uliopanuliwa. Uhamisho na uidhinishaji.</p></div>
      <div class="feature-card"><h3>Ufuatiliaji wa Mizigo na FEFO</h3><p>Fuatilia kwa nambari ya mizigo na tarehe ya kumalizika. FEFO. Tahadhari za muda wa matumizi. Muhimu kwa chakula na dawa.</p></div>
      <div class="feature-card"><h3>Mtandao wa Mawakala</h3><p>Sajili mawakala, panga maeneo na hisa. Fuatilia mauzo ya kila siku. Hesabu kamisheni. Ufikiaji wa self-service.</p></div>
      <div class="feature-card"><h3>Ununuzi na Upokeaji</h3><p>Amri za ununuzi, risiti za bidhaa na upatanisho wa tatu. Fuatilia utendaji wa wauzaji. Kuagiza tena kwa otomatiki.</p></div>
      <div class="feature-card"><h3>Utekelezaji wa Amri</h3><p>Amri za mauzo, orodha za uteuzi, risiti za utoaji na ufuatiliaji wa usafirishaji. Utoaji wa sehemu na nyongeza zinasaidiwa.</p></div>
      <div class="feature-card"><h3>Ripoti za Usambazaji</h3><p>Mauzo kwa eneo, mawakala, bidhaa na kipindi. Mzunguko wa hisa kati ya maeneo. Utendaji na kamisheni za mawakala.</p></div>
    </div>
  </div></section>

  <section class="section--dark section"><div class="container text-center">
    <h2>Ona Kraal Code kwa biashara</h2><p>Oma onyesho lililobinafsishwa kwa shughuli zako za biashara na usambazaji.</p>
    <a href="/sw/mawasiliano/" class="btn btn--inverse">Oma Onyesho →</a>
  </div></section>
</BaseLayout>

<style>
  .page-hero{padding:var(--kc-space-20) 0 var(--kc-space-12)}.page-hero h1{font-size:var(--kc-text-4xl);max-width:700px}.page-hero-subtext{font-size:var(--kc-text-lg);color:var(--kc-text-secondary);max-width:60ch;margin-top:var(--kc-space-4)}.breadcrumb ol{list-style:none;padding:0;display:flex;gap:var(--kc-space-2);font-size:var(--kc-text-sm);color:var(--kc-text-tertiary);margin-bottom:var(--kc-space-6)}.breadcrumb a{color:var(--kc-teal);text-decoration:none}.breadcrumb li:not(:last-child)::after{content:'/';margin-left:var(--kc-space-2);color:var(--kc-text-tertiary)}.container--narrow{max-width:var(--kc-container-narrow)}.challenge-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:var(--kc-space-6);margin-top:var(--kc-space-6)}.challenge-item{padding:var(--kc-space-5);border-left:3px solid var(--kc-warning)}.challenge-item h3{font-size:var(--kc-text-base);font-family:var(--kc-font-body);font-weight:var(--kc-weight-semibold);margin-bottom:var(--kc-space-1)}.challenge-item p{font-size:var(--kc-text-sm);color:var(--kc-text-secondary)}.feature-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:var(--kc-space-6);margin-top:var(--kc-space-8)}.feature-card{padding:var(--kc-space-6);background:var(--kc-surface-light);border:1px solid var(--kc-border-subtle);border-radius:var(--kc-radius-lg)}.feature-card h3{font-size:var(--kc-text-lg);font-family:var(--kc-font-body);font-weight:var(--kc-weight-semibold);margin-bottom:var(--kc-space-2)}.feature-card p{font-size:var(--kc-text-sm);color:var(--kc-text-secondary)}.btn--inverse{display:inline-flex;align-items:center;padding:var(--kc-space-4) var(--kc-space-8);font-weight:var(--kc-weight-semibold);font-size:var(--kc-text-base);border-radius:var(--kc-radius-lg);background:transparent;color:var(--kc-text-inverse);border:2px solid var(--kc-teal-light);transition:all var(--kc-transition-fast);text-decoration:none;margin-top:var(--kc-space-6)}.btn--inverse:hover{background:var(--kc-teal);border-color:var(--kc-teal)}@media(max-width:768px){.page-hero h1{font-size:var(--kc-text-3xl)}.challenge-grid,.feature-grid{grid-template-columns:1fr}}
</style>
