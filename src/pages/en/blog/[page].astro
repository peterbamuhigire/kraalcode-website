---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostCard from '../../../components/blog/PostCard.astro';
import Pagination from '../../../components/blog/Pagination.astro';
import { blogSlug, sortPosts } from '../../../utils/blog';

const pageSize = 6;
const entries = sortPosts(await getCollection('blog', ({ data }) => data.locale === 'en' && data.published));
const nonFeatured = entries.filter((entry) => !entry.data.featured);
const pageCount = Math.max(1, Math.ceil(nonFeatured.length / pageSize));
export async function getStaticPaths() {
  const pageSizeForPaths = 6;
  const entriesForPaths = sortPosts(await getCollection('blog', ({ data }) => data.locale === 'en' && data.published));
  const nonFeaturedForPaths = entriesForPaths.filter((entry) => !entry.data.featured);
  const pageCountForPaths = Math.max(1, Math.ceil(nonFeaturedForPaths.length / pageSizeForPaths));
  return Array.from({ length: pageCountForPaths }, (_, index) => ({
    params: { page: String(index + 2) },
    props: { pageNumber: index + 2 },
  }));
}

const { pageNumber } = Astro.props;
const currentPage = Number(pageNumber);
const posts = nonFeatured.slice((currentPage - 2) * pageSize, (currentPage - 1) * pageSize);
---

<BaseLayout
  title={`Blog — Page ${currentPage}`}
  description="Research-backed guidance for growing African organisations."
  locale="en"
  canonicalUrl={`https://kraalcode.com/en/blog/${currentPage}/`}
  alternateUrls={{ en: `/en/blog/${currentPage}/` }}
>
  <section class="section section--warm page-heading">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb"><ol><li><a href="/en/">Home</a></li><li><a href="/en/blog/">Blog</a></li><li aria-current="page">Page {currentPage}</li></ol></nav>
      <p class="eyebrow">Kraal Code journal</p>
      <h1>More practical insight</h1>
      <p>Page {currentPage} of {pageCount + 1} · {entries.length} published articles</p>
    </div>
  </section>
  <section class="section"><div class="container"><div class="post-grid">{posts.map((post) => <PostCard post={{ slug: blogSlug(post), data: post.data }} />)}</div><Pagination currentPage={currentPage} totalPages={pageCount + 1} basePath="/en/blog" /></div></section>
</BaseLayout>

<style>
  .page-heading { padding-bottom: var(--kc-space-12); }
  .breadcrumb ol { list-style: none; display: flex; gap: var(--kc-space-2); padding: 0; margin: 0 0 var(--kc-space-8); color: var(--kc-text-tertiary); font-size: var(--kc-text-sm); }
  .breadcrumb a { color: var(--kc-teal-deep); }
  .breadcrumb li:not(:last-child)::after { content: '/'; margin-left: var(--kc-space-2); }
  .eyebrow { margin: 0 0 var(--kc-space-3); color: var(--kc-teal-deep); font-size: var(--kc-text-sm); font-weight: var(--kc-weight-bold); letter-spacing: .08em; text-transform: uppercase; }
  h1 { font-size: clamp(var(--kc-text-4xl), 7vw, var(--kc-text-5xl)); }
  .page-heading p:last-child { margin-top: var(--kc-space-4); color: var(--kc-text-secondary); }
  .post-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--kc-space-6); }
  @media (max-width: 900px) { .post-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 640px) { .post-grid { grid-template-columns: 1fr; } }
</style>
