---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
const locale = 'en';
---

<BaseLayout
  title="Non-Profits & NGOs — ERP for Donor-Funded Organisations"
  description="Kraal Code for non-profits and NGOs: donor-restricted fund accounting, project tracking, departmental budgets, M&E dashboards, and audit-ready financial reporting."
  locale={locale}
  canonicalUrl="https://kraalcode.com/en/sectors/nonprofits/"
>
  <section class="page-hero section--warm">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb"><ol><li><a href="/en/">Home</a></li><li><a href="/en/sectors/">Sectors</a></li><li aria-current="page">Non-Profits & NGOs</li></ol></nav>
      <h1>Non-Profits & NGOs</h1>
      <p class="page-hero-subtext">Track donor funds, manage projects, report to funders, and maintain audit-ready books — without a separate accounting system for each grant.</p>
    </div>
  </section>

  <section class="section"><div class="container container--narrow">
    <h2>Your challenges</h2>
    <div class="challenge-grid">
      <div class="challenge-item"><h3>Donor restrictions</h3><p>Funders restrict how their money is spent. Tracking which funds are restricted, for what purpose, and whether spending complies requires parallel spreadsheets and manual reconciliation.</p></div>
      <div class="challenge-item"><h3>Project budgeting</h3><p>Each project has its own budget, timeline, and reporting requirements. Tracking actual vs planned spending per project — across multiple donors — is labour-intensive.</p></div>
      <div class="challenge-item"><h3>Funder reporting</h3><p>Different funders require different report formats. Generating these reports from a general ledger that was not designed for fund accounting takes days every quarter.</p></div>
      <div class="challenge-item"><h3>Audit readiness</h3><p>External auditors require clean records, complete documentation, and a clear trail from expenditure to approval. Paper-based or spreadsheet systems make audits painful.</p></div>
    </div>
  </div></section>

  <section class="section section--warm"><div class="container">
    <h2>How Kraal Code helps</h2>
    <div class="feature-grid">
      <div class="feature-card"><h3>Fund Accounting</h3><p>Track restricted and unrestricted funds separately. Allocate expenses to specific donors, projects, and budget lines. Generate fund-level financial statements.</p></div>
      <div class="feature-card"><h3>Project Costing</h3><p>Set project budgets by category. Track actual vs planned with variance analysis. Allocate shared costs across projects. Generate project profitability reports.</p></div>
      <div class="feature-card"><h3>Departmental Budgets</h3><p>Manage budgets by department, project, or programme. Lock budgets after approval. Track budget vs actual in real time. Alert when spending approaches limits.</p></div>
      <div class="feature-card"><h3>Financial Statements</h3><p>Generate balance sheet, income statement, cash flow statement, and trial balance. Departmental and consolidated views. Export to PDF or Excel in formats funders expect.</p></div>
      <div class="feature-card"><h3>Audit Trail</h3><p>Every transaction is immutable. The INSERT-only audit log records who did what, from which IP, at what time. External auditor role provides read-only access.</p></div>
      <div class="feature-card"><h3>Monitoring & Evaluation</h3><p>Track M&E exercises, issues, responses, and action items. Generate board reports and M&E dashboards. Link programme outcomes to financial data.</p></div>
    </div>
  </div></section>

  <section class="section"><div class="container">
    <h2>See it in action</h2>
    <p class="screenshot-intro">Screenshots from the live Kraal Code system — coming soon.</p>
    <div class="screenshot-grid">
      <div class="screenshot-slot"><div class="screenshot-placeholder"><span class="screenshot-label">Budget Performance</span><span class="screenshot-note">Live product screenshot — coming soon</span></div></div>
      <div class="screenshot-slot"><div class="screenshot-placeholder"><span class="screenshot-label">Compliance Dashboard</span><span class="screenshot-note">Live product screenshot — coming soon</span></div></div>
    </div>
  </div></section>

  <section class="section--dark section"><div class="container text-center">
    <h2>See Kraal Code for non-profits</h2><p>Request a demonstration tailored to your donor-funded operations.</p>
    <a href="/en/contact/" class="btn btn--inverse">Request a Demonstration →</a>
  </div></section>
</BaseLayout>

<style>
  .page-hero{padding:var(--kc-space-20) 0 var(--kc-space-12)}.page-hero h1{font-size:var(--kc-text-4xl);max-width:700px}.page-hero-subtext{font-size:var(--kc-text-lg);color:var(--kc-text-secondary);max-width:60ch;margin-top:var(--kc-space-4)}.breadcrumb ol{list-style:none;padding:0;display:flex;gap:var(--kc-space-2);font-size:var(--kc-text-sm);color:var(--kc-text-tertiary);margin-bottom:var(--kc-space-6)}.breadcrumb a{color:var(--kc-teal);text-decoration:none}.breadcrumb li:not(:last-child)::after{content:'/';margin-left:var(--kc-space-2);color:var(--kc-text-tertiary)}.container--narrow{max-width:var(--kc-container-narrow)}.challenge-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:var(--kc-space-6);margin-top:var(--kc-space-6)}.challenge-item{padding:var(--kc-space-5);border-left:3px solid var(--kc-warning)}.challenge-item h3{font-size:var(--kc-text-base);font-family:var(--kc-font-body);font-weight:var(--kc-weight-semibold);margin-bottom:var(--kc-space-1)}.challenge-item p{font-size:var(--kc-text-sm);color:var(--kc-text-secondary)}.feature-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:var(--kc-space-6);margin-top:var(--kc-space-8)}.feature-card{padding:var(--kc-space-6);background:var(--kc-surface-light);border:1px solid var(--kc-border-subtle);border-radius:var(--kc-radius-lg)}.feature-card h3{font-size:var(--kc-text-lg);font-family:var(--kc-font-body);font-weight:var(--kc-weight-semibold);margin-bottom:var(--kc-space-2)}.feature-card p{font-size:var(--kc-text-sm);color:var(--kc-text-secondary)}.screenshot-intro{color:var(--kc-text-secondary);margin-bottom:var(--kc-space-6)}.screenshot-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:var(--kc-space-6)}.screenshot-placeholder{aspect-ratio:16/10;background:var(--kc-surface-warm);border:2px dashed var(--kc-border);border-radius:var(--kc-radius-lg);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:var(--kc-space-2)}.screenshot-label{font-weight:var(--kc-weight-semibold);color:var(--kc-text-primary)}.screenshot-note{font-size:var(--kc-text-sm);color:var(--kc-text-tertiary)}.btn--inverse{display:inline-flex;align-items:center;padding:var(--kc-space-4) var(--kc-space-8);font-weight:var(--kc-weight-semibold);font-size:var(--kc-text-base);border-radius:var(--kc-radius-lg);background:transparent;color:var(--kc-text-inverse);border:2px solid var(--kc-teal-light);transition:all var(--kc-transition-fast);text-decoration:none;margin-top:var(--kc-space-6)}.btn--inverse:hover{background:var(--kc-teal);border-color:var(--kc-teal)}@media(max-width:768px){.page-hero h1{font-size:var(--kc-text-3xl)}.challenge-grid,.feature-grid,.screenshot-grid{grid-template-columns:1fr}}
</style>
