---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
const locale = 'en';
---

<BaseLayout
  title="Cookie Notice — Kraal Code"
  description="How Kraal Code uses cookies and similar technologies on our website."
  locale={locale}
  canonicalUrl="https://kraalcode.com/en/legal/cookies/"
>
  <section class="page-hero section--warm">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb"><ol><li><a href="/en/">Home</a></li><li>Legal</li><li aria-current="page">Cookie Notice</li></ol></nav>
      <h1>Cookie Notice</h1>
      <p class="draft-notice">DRAFT — pending legal review. Last updated: 9 August 2026.</p>
    </div>
  </section>

  <section class="section"><div class="container container--narrow legal-content">
    <h2>What are cookies?</h2>
    <p>Cookies are small text files stored on your device when you visit a website. They help the website remember your preferences and understand how you use the site.</p>

    <h2>Cookies we use</h2>
    <h3>Essential cookies</h3>
    <p>These cookies are necessary for the website to function. They cannot be disabled.</p>
    <ul>
      <li><strong>Session cookie:</strong> maintains your language preference during your visit</li>
      <li><strong>Security cookie:</strong> protects against cross-site request forgery</li>
    </ul>

    <h3>Analytics cookies (future)</h3>
    <p>When implemented, analytics cookies will help us understand how visitors use our website. These will only be set with your explicit consent. We will use privacy-respecting analytics that do not track individual users across websites.</p>

    <h2>Managing cookies</h2>
    <p>You can control cookies through your browser settings. Disabling essential cookies may affect website functionality.</p>

    <h2>Third-party cookies</h2>
    <p>We do not currently use any third-party cookies. If this changes, we will update this notice and request your consent where required.</p>

    <h2>Contact</h2>
    <p>For questions about our use of cookies, contact us at <a href="mailto:info@kraalcode.com">info@kraalcode.com</a>.</p>
  </div></section>
</BaseLayout>

<style>
  .page-hero{padding:var(--kc-space-20) 0 var(--kc-space-12)}.page-hero h1{font-size:var(--kc-text-4xl)}
  .draft-notice{display:inline-block;padding:var(--kc-space-2) var(--kc-space-4);background:var(--kc-warning-light);border:1px solid var(--kc-warning);border-radius:var(--kc-radius-md);font-size:var(--kc-text-sm);color:var(--kc-warning);margin-top:var(--kc-space-4)}
  .breadcrumb ol{list-style:none;padding:0;display:flex;gap:var(--kc-space-2);font-size:var(--kc-text-sm);color:var(--kc-text-tertiary);margin-bottom:var(--kc-space-6)}.breadcrumb a{color:var(--kc-teal);text-decoration:none}.breadcrumb li:not(:last-child)::after{content:'/';margin-left:var(--kc-space-2);color:var(--kc-text-tertiary)}
  .container--narrow{max-width:var(--kc-container-narrow)}
  .legal-content h2{font-size:var(--kc-text-xl);margin-top:var(--kc-space-10);margin-bottom:var(--kc-space-4)}
  .legal-content h3{font-size:var(--kc-text-lg);margin-top:var(--kc-space-6);margin-bottom:var(--kc-space-3)}
  .legal-content p,.legal-content li{font-size:var(--kc-text-base);color:var(--kc-text-secondary);line-height:var(--kc-leading-relaxed)}
  .legal-content ul{margin:var(--kc-space-3) 0 var(--kc-space-4) var(--kc-space-6)}
  .legal-content li{margin-bottom:var(--kc-space-2)}
  .legal-content a{color:var(--kc-teal)}
  @media(max-width:768px){.page-hero h1{font-size:var(--kc-text-3xl)}}
</style>
