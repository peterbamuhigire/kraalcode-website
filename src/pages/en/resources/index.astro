---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const locale = 'en';
---

<BaseLayout
  title="Resources — Guides, Insights, and Implementation Support"
  description="Explore Kraal Code resources: implementation guides, buyer questions, security updates, product news, and thought leadership for African organisations."
  locale={locale}
  canonicalUrl="https://kraalcode.com/en/resources/"
>
  <section class="page-hero section--warm">
    <div class="container">
      <h1>Resources for your journey</h1>
      <p class="page-hero-subtext">Implementation guides, buyer questions, security updates, and insights to help you make the most of Kraal Code.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="resources-grid">
        <div class="resource-card">
          <span class="resource-type">Guide</span>
          <h2>Getting Started with Kraal Code</h2>
          <p>A step-by-step guide to setting up your organisation, configuring your chart of accounts, adding users, and recording your first transactions.</p>
          <span class="resource-meta">Coming soon</span>
        </div>

        <div class="resource-card">
          <span class="resource-type">Guide</span>
          <h2>Choosing the Right Plan</h2>
          <p>How to assess your organisation's size, module needs, and growth trajectory to select the Kraal Code plan that fits.</p>
          <span class="resource-meta">Coming soon</span>
        </div>

        <div class="resource-card">
          <span class="resource-type">Article</span>
          <h2>Security Architecture Overview</h2>
          <p>A detailed look at how Kraal Code protects your data: tenant isolation, encryption, audit trails, and access controls explained in plain language.</p>
          <span class="resource-meta">Coming soon</span>
        </div>

        <div class="resource-card">
          <span class="resource-type">Guide</span>
          <h2>Moving from Spreadsheets to Kraal Code</h2>
          <p>How to transition from Excel, QuickBooks, or manual systems to Kraal Code without losing data or disrupting operations.</p>
          <span class="resource-meta">Coming soon</span>
        </div>

        <div class="resource-card">
          <span class="resource-type">Article</span>
          <h2>Multi-Branch Operations</h2>
          <p>How to set up and manage multiple branches, warehouses, and locations with centralised visibility and local control.</p>
          <span class="resource-meta">Coming soon</span>
        </div>

        <div class="resource-card">
          <span class="resource-type">Article</span>
          <h2>Mobile Money Integration</h2>
          <p>How Kraal Code integrates with MTN MoMo, Airtel Money, and M-Pesa for payments, receipts, and salary disbursement.</p>
          <span class="resource-meta">Coming soon</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section--dark section">
    <div class="container text-center">
      <h2>Have a question we haven't covered?</h2>
      <p>We are happy to discuss your specific needs and challenges.</p>
      <a href="/en/contact/" class="btn btn--inverse">Contact Us →</a>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    padding: var(--kc-space-20) 0 var(--kc-space-12);
  }

  .page-hero h1 {
    font-size: var(--kc-text-4xl);
    max-width: 700px;
  }

  .page-hero-subtext {
    font-size: var(--kc-text-lg);
    color: var(--kc-text-secondary);
    max-width: 60ch;
    margin-top: var(--kc-space-4);
  }

  .resources-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--kc-space-6);
  }

  .resource-card {
    padding: var(--kc-space-8);
    border: 1px solid var(--kc-border-subtle);
    border-radius: var(--kc-radius-lg);
    transition: border-color var(--kc-transition-fast);
  }

  .resource-card:hover {
    border-color: var(--kc-teal);
  }

  .resource-type {
    display: inline-block;
    font-size: var(--kc-text-xs);
    font-weight: var(--kc-weight-semibold);
    color: var(--kc-teal);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: var(--kc-space-3);
  }

  .resource-card h2 {
    font-size: var(--kc-text-xl);
    font-family: var(--kc-font-body);
    font-weight: var(--kc-weight-semibold);
    color: var(--kc-charcoal);
    margin-bottom: var(--kc-space-3);
  }

  .resource-card p {
    font-size: var(--kc-text-sm);
    color: var(--kc-text-secondary);
    margin-bottom: var(--kc-space-4);
  }

  .resource-meta {
    font-size: var(--kc-text-xs);
    color: var(--kc-text-tertiary);
    font-style: italic;
  }

  .btn--inverse {
    display: inline-flex;
    align-items: center;
    padding: var(--kc-space-4) var(--kc-space-8);
    font-weight: var(--kc-weight-semibold);
    font-size: var(--kc-text-base);
    border-radius: var(--kc-radius-lg);
    background: transparent;
    color: var(--kc-text-inverse);
    border: 2px solid var(--kc-teal-light);
    transition: all var(--kc-transition-fast);
    text-decoration: none;
    margin-top: var(--kc-space-6);
  }

  .btn--inverse:hover {
    background: var(--kc-teal);
    border-color: var(--kc-teal);
  }

  @media (max-width: 768px) {
    .resources-grid { grid-template-columns: 1fr; }
    .page-hero h1 { font-size: var(--kc-text-3xl); }
  }
</style>
