---
import BaseLayout from '../../layouts/BaseLayout.astro';

type Locale = 'en' | 'fr' | 'sw';

export function getStaticPaths() {
  const routeLabels: Record<string, string> = {
    'en/pricing': 'Pricing',
    'en/implementation': 'Implementation',
    'en/capabilities/accounting': 'Finance and Accounting',
    'en/capabilities/inventory': 'Inventory and Warehousing',
    'en/capabilities/sales': 'Sales and Customer Operations',
    'en/capabilities/procurement': 'Procurement and Suppliers',
    'en/capabilities/manufacturing': 'Manufacturing and Production',
    'en/capabilities/hr-payroll': 'HR and Payroll',
    'en/capabilities/projects': 'Projects and Work Planning',
    'en/capabilities/reporting': 'Reporting and Insight',
    'en/sectors/manufacturing': 'Manufacturing',
    'en/sectors/trading': 'Trading and Distribution',
    'en/sectors/nonprofits': 'Non-Profits and NGOs',
    'en/sectors/consultancy': 'Consultancy and Professional Services',
    'en/sectors/agriculture': 'Agriculture and Cooperatives',
    'en/sectors/retail': 'Retail and POS',
    'en/sectors/hospitality': 'Hospitality',
    'en/sectors/education': 'Schools and Education',
    'en/legal/privacy': 'Privacy Notice',
    'en/legal/cookies': 'Cookie Notice',
    'en/legal/terms': 'Website Terms',
    'en/legal/accessibility': 'Accessibility',
    'en/security/disclosure': 'Responsible Disclosure',
    'fr/produit': 'Produit',
    'fr/product': 'Produit',
    'fr/capacites': 'Capacites',
    'fr/capabilities': 'Capacites',
    'fr/capacites/comptabilite': 'Comptabilite',
    'fr/capacites/inventaire': 'Inventaire',
    'fr/capacites/ventes': 'Ventes',
    'fr/capacites/achats': 'Achats',
    'fr/capacites/fabrication': 'Fabrication',
    'fr/capacites/rh-paie': 'RH et paie',
    'fr/capacites/projets': 'Projets',
    'fr/capacites/rapports': 'Rapports',
    'fr/secteurs': 'Secteurs',
    'fr/sectors': 'Secteurs',
    'fr/pourquoi': 'Pourquoi Kraal Code',
    'fr/why': 'Pourquoi Kraal Code',
    'fr/securite': 'Securite',
    'fr/security': 'Securite',
    'fr/ressources': 'Ressources',
    'fr/resources': 'Ressources',
    'fr/entreprise': 'Entreprise',
    'fr/company': 'Entreprise',
    'fr/contact': 'Contact',
    'fr/travailler-de-partout': 'Travailler de partout',
    'fr/mise-en-oeuvre': 'Mise en oeuvre',
    'fr/tarifs': 'Tarifs',
    'fr/juridique/confidentialite': 'Politique de confidentialite',
    'fr/juridique/cookies': 'Politique relative aux cookies',
    'fr/juridique/conditions': 'Conditions du site',
    'fr/juridique/accessibilite': 'Accessibilite',
    'sw/product': 'Bidhaa',
    'sw/bidhaa': 'Bidhaa',
    'sw/capabilities': 'Uwezo',
    'sw/uwezo': 'Uwezo',
    'sw/uwezo/hasibu': 'Hasibu',
    'sw/uwezo/hisa': 'Hisa',
    'sw/uwezo/mauzo': 'Mauzo',
    'sw/uwezo/manunuzi': 'Manunuzi',
    'sw/uwezo/uzalishaji': 'Uzalishaji',
    'sw/uwezo/hr-mishahara': 'HR na mishahara',
    'sw/uwezo/miradi': 'Miradi',
    'sw/uwezo/ripoti': 'Ripoti',
    'sw/sectors': 'Sekta',
    'sw/sekta': 'Sekta',
    'sw/why': 'Kwa nini Kraal Code',
    'sw/kwa-nini': 'Kwa nini Kraal Code',
    'sw/security': 'Usalama',
    'sw/usalama': 'Usalama',
    'sw/resources': 'Rasilimali',
    'sw/rasilimali': 'Rasilimali',
    'sw/company': 'Kampuni',
    'sw/kampuni': 'Kampuni',
    'sw/contact': 'Mawasiliano',
    'sw/mawasiliano': 'Mawasiliano',
    'sw/fanya-kazi-popote': 'Fanya kazi popote',
    'sw/utekelezaji': 'Utekelezaji',
    'sw/bei': 'Bei',
    'sw/kisheria/faragha': 'Sera ya Faragha',
    'sw/kisheria/vidakuzi': 'Sera ya Vidakuzi',
    'sw/kisheria/masharti': 'Masharti ya Tovuti',
    'sw/kisheria/ufikiaji': 'Ufikiaji',
  };

  return Object.keys(routeLabels).map((route) => {
    const [locale, ...slug] = route.split('/');

    return {
      params: { locale, slug: slug.join('/') },
      props: {
        locale: locale as Locale,
        route,
        title: routeLabels[route],
      },
    };
  });
}

const { locale, route, title } = Astro.props as {
  locale: Locale;
  route: string;
  title: string;
};

const localizedHome = `/${locale}/`;
const canonicalUrl = `https://kraalcode.com/${route}/`;
const description = `${title} information for Kraal Code.`;
---

<BaseLayout
  title={`${title} - Kraal Code`}
  description={description}
  locale={locale}
  canonicalUrl={canonicalUrl}
>
  <section class="route-shell section section--warm section--lg">
    <div class="container route-inner">
      <p class="eyebrow">Kraal Code</p>
      <h1>{title}</h1>
      <p>
        This page is part of the Kraal Code website structure and is being expanded
        into a dedicated resource. Use the current overview pages to explore the
        product, capabilities, sectors, security, and contact options.
      </p>
      <div class="route-actions">
        <a class="btn btn--primary" href={localizedHome}>Back to {locale.toUpperCase()} home</a>
        <a class="btn btn--outline" href={`/${locale}/contact/`}>Contact Kraal Code</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .route-inner {
    max-width: 760px;
  }

  .eyebrow {
    color: var(--kc-teal);
    font-size: var(--kc-text-sm);
    font-weight: var(--kc-weight-semibold);
    letter-spacing: 0.05em;
    margin-bottom: var(--kc-space-4);
    text-transform: uppercase;
  }

  h1 {
    color: var(--kc-charcoal);
    font-size: var(--kc-text-5xl);
    margin-bottom: var(--kc-space-5);
  }

  p {
    color: var(--kc-text-secondary);
    font-size: var(--kc-text-lg);
  }

  .route-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--kc-space-4);
    margin-top: var(--kc-space-8);
  }
</style>
