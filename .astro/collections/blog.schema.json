{
  "$ref": "#/definitions/blog",
  "definitions": {
    "blog": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "excerpt": {
          "type": "string"
        },
        "date": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "integer",
              "format": "unix-time"
            }
          ]
        },
        "updated": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "integer",
              "format": "unix-time"
            }
          ]
        },
        "author": {
          "type": "string"
        },
        "locale": {
          "type": "string",
          "enum": [
            "en",
            "fr",
            "sw"
          ]
        },
        "category": {
          "type": "string",
          "enum": [
            "product-updates",
            "industry-insights",
            "how-to-guides",
            "security-compliance",
            "customer-stories"
          ]
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "featured": {
          "type": "boolean",
          "default": false
        },
        "published": {
          "type": "boolean",
          "default": true
        },
        "image": {
          "type": "string"
        },
        "imageAlt": {
          "type": "string"
        },
        "readingTime": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "seoTitle": {
          "type": "string"
        },
        "metaDescription": {
          "type": "string"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string"
              },
              "publisher": {
                "type": "string"
              },
              "url": {
                "type": "string",
                "format": "uri"
              }
            },
            "required": [
              "title",
              "publisher",
              "url"
            ],
            "additionalProperties": false
          },
          "default": []
        },
        "$schema": {
          "type": "string"
        }
      },
      "required": [
        "title",
        "excerpt",
        "date",
        "author",
        "locale",
        "category",
        "image",
        "imageAlt",
        "readingTime"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}